POSTGRES_DB=stockcontrol
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=change_me
API_HOST_PORT=8088
NODE_ENV=development
JWT_SECRET=change_me_long_random
MAGIC_LINK_CALLBACK_URL=stockcontrol://auth?token={{token}}
MAGIC_LINK_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
# Dev: si no configuras SMTP, podés pedir link mágico y el API devuelve el token en la respuesta.
AUTH_DEV_RETURN_TOKEN=true
# SMTP_* opcional (para enviar el link mágico)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# CORS_ORIGIN opcional (separado por comas). Si se deja vacío, permite cualquier origen.
CORS_ORIGIN=
# OCR worker
OCR_WORKER_ENABLED=true
OCR_WORKER_POLL_MS=2000
